{
  "name": "gift-store",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "npm run db:migrate",
    "db:seed": "tsx src/db/seed.ts",
    "setup": "npm run db:push && npm run db:seed",
    "test": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:import": "tsx src/db/import-catalog.ts",
    "db:migrate": "tsx src/db/migrate.ts && drizzle-kit push < /dev/null && tsx src/db/migrate.ts verify",
    "start:prod": "npm run db:migrate && tsx src/db/seed.ts && tsx src/db/import-catalog.ts && next start -H 0.0.0.0 -p ${PORT:-3000}"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fabric": "^6.9.1",
    "ip3country": "^5.0.0",
    "jszip": "^3.10.2",
    "next": "^15.5.29",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "three": "^0.117.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "zustand": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
