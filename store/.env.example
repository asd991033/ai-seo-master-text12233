# 站點語系（之後各國站台各自部署、各自設定）
NEXT_PUBLIC_SITE_LOCALE=zh-TW
# 資料庫：本機用檔案；正式環境可改 Turso (libsql://...) 並填 token
DATABASE_URL=file:./data/store.db
DATABASE_AUTH_TOKEN=
# 上傳檔案（設計稿、刀模、商品圖）存放目錄
STORAGE_DIR=./data/files
# 首次 seed 建立的管理員帳號
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# 網站正式網址（用於第三方登入回呼）；未設定時以請求的網域為準
SITE_URL=
# Google 登入：Google Cloud Console → OAuth 用戶端，回呼網址 {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LINE 登入：LINE Developers → LINE Login channel，回呼網址 {SITE_URL}/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
SHOPIFY_DOMAINS=

# ── 海外站（/sg /my /au /ae /uk，英文）──
# Stripe 線上付款（海外站用）。Webhook 端點：https://你的網域/api/stripe/webhook
# 事件選 checkout.session.completed 與 checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 匯率：1 新台幣換多少當地幣（不設定就用程式內的預設值）。改完要重新部署
NEXT_PUBLIC_FX_USD=
NEXT_PUBLIC_FX_SGD=
NEXT_PUBLIC_FX_MYR=
NEXT_PUBLIC_FX_AUD=
NEXT_PUBLIC_FX_AED=
NEXT_PUBLIC_FX_GBP=
# 各國運費：運費,免運門檻（當地幣別），例：NEXT_PUBLIC_SHIP_SG=15,150
NEXT_PUBLIC_SHIP_US=
NEXT_PUBLIC_SHIP_SG=
NEXT_PUBLIC_SHIP_MY=
NEXT_PUBLIC_SHIP_AU=
NEXT_PUBLIC_SHIP_AE=
NEXT_PUBLIC_SHIP_GB=
# HiCustom 各國的物流名稱（不設定就由 HiCustom 依帳號預設規則配對）
HICUSTOM_LOGISTICS_SG=

# GA4 Measurement Protocol 的 API 密鑰：有設定才會由伺服器補送「購買」事件（ATM／超商付款的訂單）
GA_API_SECRET=
